% baocao.sty — Định dạng Bài tập lớn theo "Tài liệu hướng dẫn trình bày báo cáo"
% (BM Vật liệu Năng lượng & Ứng dụng, ĐH Bách Khoa TP.HCM, 01/2018).
% Biên dịch bằng XeLaTeX (Overleaf: Menu → Compiler → XeLaTeX), chạy 2 lần.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{baocao}[2026/11/13 Bao cao BTL]

% ---------- 3.1 Trang: A4, in 1 mặt, mọi trang cùng một lề (đã bỏ twoside và bindingoffset) ----------
% 3.3 Header/Footer cách mép 12,7 mm
\RequirePackage[a4paper,top=20mm,bottom=20mm,left=30mm,right=20mm,
  headheight=8mm,headsep=4.7mm,footskip=12.7mm]{geometry}

% ---------- 3.2 Font Times New Roman 13 pt, dòng 1,5 lines, cách đoạn 6+6 pt ----------
\RequirePackage[fontsize=13pt]{scrextend}
\RequirePackage{fontspec}
\IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{\setmainfont{TeX Gyre Termes}}
\RequirePackage[vietnamese]{babel}
\RequirePackage{setspace}
\setstretch{1.44}% ≈ "1.5 lines" của Word với TNR 13 pt
\setlength\parindent{12.7mm}% thụt dòng đầu 1,27 cm
\RequirePackage{indentfirst}% đoạn đầu sau tiêu đề chương/đề mục cũng thụt dòng đầu
\setlength\parskip{12pt plus 2pt}% Before 6 pt + After 6 pt
\setlength\emergencystretch{3em}% cho phép ngắt dòng khi có chuỗi \texttt/URL dài, tránh tràn lề

\addto\captionsvietnamese{%
  \renewcommand\chaptername{Chương}%
  \renewcommand\contentsname{Mục lục}%
  \renewcommand\listfigurename{Danh mục hình vẽ}%
  \renewcommand\listtablename{Danh mục bảng biểu}%
  \renewcommand\bibname{Tài liệu tham khảo}%
  \renewcommand\figurename{Hình}%
  \renewcommand\tablename{Bảng}}

% ---------- Thông tin báo cáo ----------
\newcommand\tenbaocao[1]{\def\bc@tenbaocao{#1}}
\newcommand\monhoc[1]{\def\bc@monhoc{#1}}
\newcommand\detai[1]{\def\bc@detai{#1}}
\newcommand\khoa[1]{\def\bc@khoa{#1}}
\newcommand\bomon[1]{\def\bc@bomon{#1}}
\newcommand\thoigian[1]{\def\bc@thoigian{#1}}
\newcommand\tacgia[1]{\def\bc@tacgia{#1}}% Header trang lẻ
\newcommand\nhomlop[1]{\def\bc@nhomlop{#1}}% dòng "Nhóm xx lớp yy - học kì aaa"
\newcommand\gvhd[1]{\def\bc@gvhd{#1}}% giảng viên hướng dẫn
\newcommand\thongtinsv[1]{\def\bc@thongtinsv{#1}}% các dòng "Họ và tên & MSSV \\ \hline"
\tenbaocao{Bài tập lớn}\monhoc{}\detai{}\khoa{}\bomon{}\thoigian{}\tacgia{}\nhomlop{}\gvhd{}\thongtinsv{}


% ---------- 5.2 Tiêu đề chương và đề mục (báo cáo phân chương) ----------
\RequirePackage{titlesec}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}
\renewcommand\thesubsubsection{\alph{subsubsection}}
\renewcommand\theparagraph{\roman{paragraph}}
% Chương: 18 pt, canh giữa, cách 18 pt, đường viền 1 pt bên dưới
\titleformat{\chapter}[display]{\centering\bfseries\fontsize{18}{21}\selectfont}
  {\chaptertitlename\ \thechapter}{18pt}{\MakeUppercase}[{\vspace{6pt}\titlerule[1pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
% 6.1 Tiêu đề trang phụ (Mục lục, Tài liệu tham khảo...): 18 pt, đậm, in hoa, canh giữa
\titleformat{name=\chapter,numberless}[block]{\centering\bfseries\fontsize{18}{21}\selectfont}
  {}{0pt}{\MakeUppercase}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{18pt}
% Cấp 1: "1.1. ĐỀ MỤC" đậm, hanging 10 mm (tự gõ IN HOA để Mục lục cũng in hoa)
\titleformat{\section}[hang]{\bfseries}{\makebox[10mm][l]{\thesection.}}{0pt}{}
\titlespacing*{\section}{0pt}{6pt}{0pt}
% Cấp 2: "1.1.1. Đề mục" đậm, hanging 15 mm
\titleformat{\subsection}[hang]{\bfseries}{\makebox[15mm][l]{\thesubsection.}}{0pt}{}
\titlespacing*{\subsection}{0pt}{6pt}{0pt}
% Cấp 3: "a) Đề mục" đậm nghiêng, left 10 mm, hanging 5 mm
\titleformat{\subsubsection}[hang]{\bfseries\itshape}{\makebox[5mm][l]{\thesubsubsection)}}{0pt}{}
\titlespacing*{\subsubsection}{10mm}{6pt}{0pt}
% Cấp 4: "i) Đề mục" nghiêng, left 15 mm, hanging 7,5 mm
\titleformat{\paragraph}[hang]{\itshape}{\makebox[7.5mm][l]{\theparagraph)}}{0pt}{}
\titlespacing*{\paragraph}{15mm}{6pt}{0pt}

% \chuong{Tên chương}: thân và Mục lục in hoa, Header trang chẵn "Chương n: Tên chương"
\newcommand\chuong[1]{%
  \chapter[\texorpdfstring{\MakeUppercase{#1}}{#1}]{#1}%
  \markboth{\chaptername\ \thechapter: #1}{}}
\renewcommand\chaptermark[1]{}

% ---------- 6.3 Mục lục, 6.5 Danh mục hình/bảng ----------
\RequirePackage[titles]{tocloft}
\renewcommand\cftchappresnum{CHƯƠNG }
\renewcommand\cftchapaftersnum{:}
\setlength\cftchapnumwidth{32mm}
\setlength\cftbeforechapskip{0pt}
\renewcommand\cftchapleader{\cftdotfill{\cftdotsep}}
\renewcommand\cftchappagefont{\normalfont}
\setlength\cftsecindent{0pt}\setlength\cftsecnumwidth{10mm}
\renewcommand\cftsecaftersnum{.}\renewcommand\cftsecfont{\bfseries}
\setlength\cftsubsecindent{0pt}\setlength\cftsubsecnumwidth{15mm}
\renewcommand\cftsubsecaftersnum{.}\renewcommand\cftsubsecfont{\bfseries}
\setlength\cftsubsubsecindent{10mm}\setlength\cftsubsubsecnumwidth{5mm}
\renewcommand\cftsubsubsecaftersnum{)}\renewcommand\cftsubsubsecfont{\bfseries\itshape}
\setlength\cftparaindent{15mm}\setlength\cftparanumwidth{7.5mm}
\renewcommand\cftparaaftersnum{)}\renewcommand\cftparafont{\itshape}
\renewcommand\cftfigpresnum{Hình }\renewcommand\cftfigaftersnum{:}
\setlength\cftfigindent{0pt}\setlength\cftfignumwidth{22.5mm}
\renewcommand\cfttabpresnum{Bảng }\renewcommand\cfttabaftersnum{:}
\setlength\cfttabindent{0pt}\setlength\cfttabnumwidth{22.5mm}
\AtBeginDocument{\addtocontents{toc}{\protect\noindent Đề mục\protect\hfill Trang\protect\par}}

% ---------- 5.8–5.9 Header/Footer ----------
\RequirePackage{fancyhdr}
\RequirePackage{emptypage}% trang trắng do \cleardoublepage không có header/footer
\RequirePackage{refcount}
% Trang ngang (hình/bảng xoay): không Header, vẫn có Footer. Khai báo \landscapepage{nhãn} trong main.tex
\newcommand\bc@landref{}
\newcommand\landscapepage[1]{\gdef\bc@landref{#1}}
\newif\ifbc@hdr
\newcommand\bc@chkhdr{\bc@hdrtrue\ifx\bc@landref\@empty\else\ifnum\value{page}=\getpagerefnumber{\bc@landref}\relax\bc@hdrfalse\fi\fi}
\newcommand\bc@footer{Trang \textbf{\thepage} / \textbf{\pageref*{bc@lastmain}}}
\fancypagestyle{main}{%
  \fancyhf{}%
  \fancyhead[R]{\bc@chkhdr\ifbc@hdr\ifodd\value{page}\bfseries\itshape\bc@tacgia\fi\fi}% trang lẻ: tên nhóm, canh phải
  \fancyhead[L]{\bc@chkhdr\ifbc@hdr\ifodd\value{page}\else\bfseries\itshape\leftmark\fi\fi}% trang chẵn: Chương n: tên chương
  \fancyfoot[C]{\bc@footer}%
  \renewcommand\headrule{\bc@chkhdr\ifbc@hdr\hrule\@height1pt\@width\headwidth\vskip-1pt\fi}\renewcommand\footrulewidth{0.5pt}}
\fancypagestyle{chapfirst}{\fancyhf{}\renewcommand\headrulewidth{0pt}\renewcommand\footrulewidth{0pt}}
\assignpagestyle{\chapter}{chapfirst}

% Phần phụ trước (< 5 trang với BTL → không đánh số trang, không Header — mục 6.3 "Chú ý")
\newcommand\phantruoc{\cleardoublepage\pagenumbering{roman}\pagestyle{empty}}
% Nội dung chính: bắt đầu trang 1 (in một mặt)
\newcommand\phanchinh{%
  \cleardoublepage\pagenumbering{arabic}\pagestyle{main}%
  \fancypagestyle{chapfirst}{\fancyhf{}\fancyfoot[C]{\bc@footer}%
    \renewcommand\headrulewidth{0pt}\renewcommand\footrulewidth{0.5pt}}}
% Phần phụ sau. \headrule phải đặt rỗng vì style main đã định nghĩa lại nó (headrulewidth=0 không đủ)
\fancypagestyle{trong}{\fancyhf{}\renewcommand\headrule{}\renewcommand\footrulewidth{0pt}}
\fancypagestyle{phu}{\fancyhf{}\fancyfoot[C]{Trang \textbf{\thepage}}%
  \renewcommand\headrule{}\renewcommand\footrulewidth{0.5pt}}
% Tài liệu tham khảo: không Header, không số trang
\newcommand\phansau{%
  \label{bc@lastmain}\cleardoublepage\pagestyle{trong}%
  \fancypagestyle{chapfirst}{\fancyhf{}\renewcommand\headrule{}\renewcommand\footrulewidth{0pt}}}
% Một Phụ lục: không Header; trang, hình, bảng, công thức đánh số "A–1", "A–2"...
\newcommand\phuluc{%
  \cleardoublepage\pagestyle{phu}%
  \fancypagestyle{chapfirst}{\fancyhf{}\fancyfoot[C]{Trang \textbf{\thepage}}%
    \renewcommand\headrule{}\renewcommand\footrulewidth{0.5pt}}%
  \setcounter{page}{1}\renewcommand\thepage{A–\arabic{page}}%
  \setcounter{figure}{0}\renewcommand\thefigure{A–\arabic{figure}}%
  \setcounter{table}{0}\renewcommand\thetable{A–\arabic{table}}%
  \setcounter{equation}{0}\renewcommand\theequation{A–\arabic{equation}}}

% ---------- 5.5 Công thức "(2–1)", 5.8 Hình/Bảng ----------
\RequirePackage{amsmath}
\renewcommand\theequation{\thechapter–\arabic{equation}}
\RequirePackage{graphicx}
\RequirePackage{caption}
\captionsetup{labelsep=colon,skip=6pt}
\captionsetup[figure]{font=it,justification=centering,position=below}
\DeclareCaptionFont{bcstretch}{\setstretch{1.44}}
\captionsetup[table]{font={bf,normalsize,bcstretch},justification=justified,singlelinecheck=false,position=above}
\AtBeginDocument{\ifdefined\LTcapwidth\setlength\LTcapwidth{\linewidth}\fi}
\renewcommand\arraystretch{1.2}
\RequirePackage{array}
\RequirePackage{float}% dùng [H] để hình/bảng nằm đúng vị trí (In line with text)

% 5.3 Bullet list: tối đa 2 cấp, thụt dòng thống nhất
\RequirePackage{enumitem}
\setlist{topsep=0pt,itemsep=0pt,parsep=0pt}
\setlist[itemize,1]{label=–,leftmargin=15mm}
\setlist[itemize,2]{label=–,leftmargin=8mm}% cả 2 cấp dùng gạch đầu dòng, không dùng bullet

% 6.3 Từ viết tắt: hanging 30 mm. Dùng: \item[CNN] Convolutional neural network – ...
\newenvironment{tuviettat}
  {\begin{list}{}{\setlength\labelwidth{30mm}\setlength\leftmargin{30mm}%
     \setlength\labelsep{0pt}\setlength\itemsep{0pt}\renewcommand\makelabel[1]{##1\hfil}}}
  {\end{list}}

% 5.7 Trích dẫn "[1–4]", "[5 tr.15]" (không dùng chỉ số trên)
\RequirePackage{cite}
\renewcommand\citemid{\nobreakspace}

